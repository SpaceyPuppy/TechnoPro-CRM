TECHNOPRO_DOMAIN=crm.example.com
TECHNOPRO_VERSION=0.1.0-mvp.1
TZ=Australia/Sydney

DB_NAME=technopro
DB_USER=technopro
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
MAX_FILE_SIZE_MB=10

# Use a mounted secondary disk or encrypted off-server mount where possible.
BACKUP_PATH=/mnt/technopro-backups

# The production API container runs as uid/gid 1000.
UPLOAD_UID=1000
UPLOAD_GID=1000
